# Copy to `.env` (or export directly) for local development. Nothing here is
# read automatically -- app/database.py and app/security.py fall back to dev
# defaults so the service runs with no setup; set these before pointing the
# app at real infrastructure.

# db -- PostgreSQL. Left unset, the app runs on a local SQLite file
# (app/database.py) so `pip install -r requirements.txt` is enough to start.
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/app

# api / worker auth -- JWT bearer tokens (app/security.py).
JWT_SECRET=change-me-in-every-real-environment

# spa -- the frontend origin(s) allowed to call this API (app/main.py).
ALLOWED_ORIGINS=http://localhost:5173

# object_store -- AWS S3, private per user. Bucket holds original uploads;
# the worker and api both need read/write.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
DOCUMENTS_BUCKET=app-documents

# queue -- AWS SQS. Decouples upload (api) from ingestion (worker).
INGESTION_QUEUE_URL=

# ai_provider -- hosted commercial embedding + chat LLM, OpenAI-compatible.
AI_PROVIDER_API_KEY=
AI_PROVIDER_BASE_URL=https://api.openai.com/v1
AI_PROVIDER_EMBEDDING_MODEL=text-embedding-3-small
AI_PROVIDER_CHAT_MODEL=gpt-4o-mini

# fair-use caps (AC-011, AC-012, AC-013).
DOCUMENTS_CAP=50
MONTHLY_QUESTION_CAP=200
